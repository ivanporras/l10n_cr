<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_cabys_sac_config_wizard" model="ir.ui.view">
            <field name="name">cabys.sac.config.wizard.form</field>
            <field name="model">cabys.sac.config.wizard</field>
            <field name="arch" type="xml">
                <form string="Configuración Cabys - SAC">
                    <sheet>
                        <group>
                            <field name="enable_cabys_sac_search"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Guardar" name="action_save" type="object" class="btn btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_cabys_sac_config_wizard" model="ir.actions.act_window">
            <field name="name">Configuración Cabys - SAC</field>
            <field name="res_model">cabys.sac.config.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_cabys_sac_config" name="Configuración Cabys - SAC" parent="cabys.menu_cabys" action="action_cabys_sac_config_wizard" sequence="99"/>
    <!-- Menú bajo Inventario retirado según solicitud -->
    </data>
</odoo>
