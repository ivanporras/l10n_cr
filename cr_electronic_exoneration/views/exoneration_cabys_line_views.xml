<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista para Códigos CABYS -->
    <record id="view_exoneration_cabys_line_tree" model="ir.ui.view">
        <field name="name">exoneration.cabys.line.tree</field>
        <field name="model">exoneration.cabys.line</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" edit="false">
                <field name="cabys_code"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- Vista Formulario para Códigos CABYS -->
    <record id="view_exoneration_cabys_line_form" model="ir.ui.view">
        <field name="name">exoneration.cabys.line.form</field>
        <field name="model">exoneration.cabys.line</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <field name="cabys_code"/>
                        <field name="description"/>
                        <field name="cabys_set_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>