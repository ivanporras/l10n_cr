<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista -->
    <record id="view_exoneration_institution_tree" model="ir.ui.view">
        <field name="name">exoneration.institution.tree</field>
        <field name="model">exoneration.institution</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="exoneration_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_exoneration_institution_form" model="ir.ui.view">
        <field name="name">exoneration.institution.form</field>
        <field name="model">exoneration.institution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_exonerations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-certificate">
                            <field name="exoneration_count" widget="statinfo" string="Exoneraciones"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="name" placeholder="Ej: Ministerio de Salud"/>
                            <field name="code" placeholder="Ej: MINSA"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="exoneration_count" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="description" placeholder="Descripción de la institución..."/>
                    </group>

                    <notebook>
                        <page string="Exoneraciones">
                            <field name="exoneration_ids" readonly="1">
                                <tree>
                                    <field name="exoneration_number"/>
                                    <field name="partner_id"/>
                                    <field name="percentage_exoneration" widget="percentage"/>
                                    <field name="date_expiration"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda -->
    <record id="view_exoneration_institution_search" model="ir.ui.view">
        <field name="name">exoneration.institution.search</field>
        <field name="model">exoneration.institution</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>

                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivas" name="inactive" domain="[('active', '=', False)]"/>

                <separator/>
                <filter string="Con Exoneraciones" name="with_exonerations"
                        domain="[('exoneration_count', '>', 0)]"/>

                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_exoneration_institution" model="ir.actions.act_window">
        <field name="name">Instituciones Emisoras</field>
        <field name="res_model">exoneration.institution</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_exoneration_institution_search"/>
        <field name="context">{
            'search_default_active': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra tu primera institución emisora!
            </p>
            <p>
                Las instituciones emisoras son las entidades gubernamentales
                que otorgan las exoneraciones de IVA a los clientes.
            </p>
            <p>
                <strong>Ejemplos:</strong> Ministerio de Salud, MEP, MOPT, etc.
            </p>
        </field>
    </record>

</odoo>