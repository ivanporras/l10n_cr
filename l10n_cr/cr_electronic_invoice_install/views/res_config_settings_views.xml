<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Configuración para Facturación Electrónica CR -->
        <record id="res_config_settings_view_form_fe_cr" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.fe.cr</field>
            <field name="model">res.config.settings</field>
            <field name="priority">20</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='account_vendor_bills']" position="after">
                    <h2>Facturación Electrónica Costa Rica</h2>
                    <div class="row mt16 o_settings_container" id="fe_cr_settings">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="module_cr_electronic_invoice"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="module_cr_electronic_invoice"/>
                                <div class="text-muted">
                                    Activar facturación electrónica según normativa de Costa Rica
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="module_cabys"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="module_cabys"/>
                                <div class="text-muted">
                                    Activar catálogo de bienes y servicios (CABYS)
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="module_cr_import_vendor_bills"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="module_cr_import_vendor_bills"/>
                                <div class="text-muted">
                                    Activar importación de facturas de proveedores
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>