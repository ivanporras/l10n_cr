<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cr_multiple_invoice_validation_view_form" model="ir.ui.view">
        <field name="name">cr.multiple.invoice.validation.form</field>
        <field name="model">cr.multiple.invoice.validation</field>
        <field name="arch" type="xml">
            <form string="Validación Masiva de Facturas">
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="not alert_warning">
                        <field name="alert_warning" readonly="1" nolabel="1" />
                    </div>
                    <group>
                        <group>
                            <field name="iva_condition" required="1" />
                            <field name="state_invoice_partner" required="1" />
                        </group>
                        <group>
                            <field name="import_bill_account_id" options="{'no_create': True}"/>
                            <field name="import_bill_account_analytic_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <separator string="Facturas a Validar"/>
                    <field name="invoice_ids" force_save="1" nolabel="1">
                        <list create="0" delete="1">
                            <field name="partner_id" />
                            <field name="invoice_date" />
                            <field name="ref" />
                            <field name="amount_total" />
                            <field name="state" widget="badge" decoration-info="state == 'draft'" />
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Validar Todas" name="run_validate" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancelar" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="cr_multiple_invoice_validation_action" model="ir.actions.act_window">
        <field name="name">Validar Facturas Masivamente</field>
        <field name="res_model">cr.multiple.invoice.validation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>