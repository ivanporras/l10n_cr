<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.cr_import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="cr_electronic_invoice.view_move_form_inherit"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='economic_activity_id']" position="after">
                <field name="iva_condition"
                       required="move_type == 'in_invoice'"
                       invisible="move_type != 'in_invoice'"/>
            </xpath>

            <xpath expr="//field[@name='economic_activity_id']" position="attributes">
                <attribute name="required">(move_type in ('out_invoice', 'out_refund') or tipo_documento in ('FE', 'FEC')) and (economic_activities_ids)</attribute>
                <attribute name="invisible">move_type not in ('out_invoice', 'out_refund') and tipo_documento not in ('FE', 'FEC')</attribute>
                <attribute name="options">{"no_open": true, "no_create": true}</attribute>
            </xpath>

        </field>
    </record>
</odoo>