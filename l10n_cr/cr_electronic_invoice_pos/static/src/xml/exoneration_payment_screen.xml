<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- 
        PaymentScreenDue - Shows exoneration banner in payment screen
    -->
    <t t-name="cr_electronic_invoice_pos.PaymentScreenDueWithExoneration" t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        
        <xpath expr="//section" position="inside">
            <div t-if="currentOrder.has_order_exoneration and currentOrder.has_order_exoneration()" class="exoneration-info mx-3 mb-2 p-2 rounded" style="background: #fff3cd; border-left: 4px solid #ffc107;">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <span style="margin-right: 6px;">🛡️</span>
                        <span style="font-weight: bold; color: #664d03; font-size: 12px;">EXONERACIÓN APLICADA</span>
                    </div>
                    <span class="badge" style="background: #ffc107; color: #664d03;">
                        <t t-esc="currentOrder.get_exoneration_info()?.percentage"/>%
                    </span>
                </div>
                <div class="mt-1" style="font-size: 11px; color: #664d03;">
                    <div class="d-flex justify-content-between">
                        <span>Impuesto original:</span>
                        <span style="text-decoration: line-through;">
                            <t t-esc="env.utils.formatCurrency(currentOrder.get_total_tax())"/>
                        </span>
                    </div>
                    <div class="d-flex justify-content-between text-success">
                        <span>Exoneración:</span>
                        <strong>- <t t-esc="env.utils.formatCurrency(currentOrder.get_total_exoneration())"/></strong>
                    </div>
                </div>
            </div>
        </xpath>
        
    </t>

</templates>
